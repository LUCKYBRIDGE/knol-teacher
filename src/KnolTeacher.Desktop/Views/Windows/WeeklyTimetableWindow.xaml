<Window x:Class="KnolTeacher.Desktop.Views.Windows.WeeklyTimetableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시간표 매니저 (주간 시간표 &amp; 기본 시간표)"
        Height="680" Width="920"
        MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BeigeAppBg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Timetable Grid Container -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Action Toolbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 안내: " FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                        <TextBlock Text="각 과목을 클릭하여 변경하거나, [수업 맞바꾸기]로 두 수업을 교환할 수 있습니다." FontSize="11" Foreground="#92400E"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📅 " FontSize="20" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="시간표 매니저" FontSize="19" FontWeight="Bold" Foreground="#1C1917" VerticalAlignment="Center"/>
                <TextBlock Text=" (주간 변동 &amp; 학기 기본)" FontSize="13" Foreground="#78716C" VerticalAlignment="Center" Margin="6,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 1. Mode Tabs -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="10" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbWeeklyTab" Content="🗓️ 이번 주 시간표 (미리 교시/수업 변경)" IsChecked="True" Checked="Tab_Checked"
                             Padding="16,6" FontWeight="Bold" FontSize="12.5" Cursor="Hand" Style="{StaticResource {x:Type ToggleButton}}">
                    <RadioButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></RadioButton.Resources>
                </RadioButton>
                <RadioButton x:Name="RbBaseTab" Content="⚙️ 기본 시간표 (학기 표준 정규 시간표)" Checked="Tab_Checked"
                             Padding="16,6" FontWeight="Bold" FontSize="12.5" Cursor="Hand" Style="{StaticResource {x:Type ToggleButton}}" Margin="4,0,0,0">
                    <RadioButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></RadioButton.Resources>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 2. Timetable Grid Viewport -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Row (Days) -->
                    <RowDefinition Height="42"/>
                    <!-- Scrollable Table Content -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: Periods & Days -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="교시 / 시간" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="월요일" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="화요일" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Background="#EFF6FF" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="수요일" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" Background="#EFF6FF" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="목요일" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" Background="#EFF6FF" CornerRadius="8" Margin="2" Padding="4">
                        <TextBlock Text="금요일" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Grid Rows Container -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="GridTimetableTable">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Dynamic Period Rows populated in code -->
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Bottom Action Toolbar -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Swap Mode Toggle Button -->
                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="BtnToggleSwapMode" Click="BtnToggleSwapMode_Click" Height="34" Padding="12,0" Margin="0,0,8,0"
                                         Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" Cursor="Hand" ToolTip="수업 교환 모드를 켜고, 맞바꿀 두 수업을 차례로 클릭하세요">
                    <Primitives:ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Primitives:ToggleButton.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔀 " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSwapModeLabel" Text="수업 맞바꾸기(스왑)" FontWeight="Bold" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </Primitives:ToggleButton>

                <!-- Reset to Base (Weekly Tab only) -->
                <Button x:Name="BtnResetToBase" Click="BtnResetToBase_Click" Content="🔄 기본 시간표로 복원" Height="34" Padding="12,0" Margin="0,0,8,0"
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand"
                        ToolTip="이번 주 변경 내용을 취소하고 학기 기본 표준 시간표로 되돌립니다"/>

                <!-- Save Current as Base (Weekly Tab only) -->
                <Button x:Name="BtnSaveAsBase" Click="BtnSaveAsBase_Click" Content="💾 현재 시간표를 기본으로 등록" Height="34" Padding="12,0"
                        Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand"
                        ToolTip="현재 시간표 배치를 앞으로 적용될 기본 표준 시간표로 저장합니다"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="닫기" Click="BtnClose_Click" Width="80" Height="34" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                <Button x:Name="BtnApplyAndClose" Click="BtnApplyAndClose_Click" Content="💾 저장 및 적용" Height="34" Padding="16,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
