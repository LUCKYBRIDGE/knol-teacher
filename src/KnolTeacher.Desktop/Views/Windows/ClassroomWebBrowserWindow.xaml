<Window x:Class="KnolTeacher.Desktop.Views.Windows.ClassroomWebBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="스마트 교실 웹 브라우저"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickLinkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Navigation & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Bookmarks / Quick Links Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Web View Surface -->
            <RowDefinition Height="*"/>
            <!-- 4. Loading / Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Navigation & Action Bar -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Nav Controls (Back, Forward, Refresh, Home) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Address / Search Bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Zoom & Screen Controls -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="BtnBack" Content="◀" Click="BtnBack_Click" Style="{StaticResource NavBtnStyle}" Width="32" Margin="0,0,4,0" ToolTip="뒤로 가기"/>
                    <Button x:Name="BtnForward" Content="▶" Click="BtnForward_Click" Style="{StaticResource NavBtnStyle}" Width="32" Margin="0,0,4,0" ToolTip="앞으로 가기"/>
                    <Button x:Name="BtnRefresh" Content="🔄" Click="BtnRefresh_Click" Style="{StaticResource NavBtnStyle}" Width="34" Margin="0,0,4,0" ToolTip="새로고침"/>
                    <Button x:Name="BtnHome" Content="🏠" Click="BtnHome_Click" Style="{StaticResource NavBtnStyle}" Width="34" ToolTip="홈으로 이동 (네이버)"/>
                </StackPanel>

                <!-- Center: Address Bar -->
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔒" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtUrl" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" KeyDown="TxtUrl_KeyDown" Text="https://www.naver.com"/>
                        <Button Grid.Column="2" Content="이동" Click="BtnGo_Click" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="8,2" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right: Utility & Window Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Controls -->
                    <Button Content="-" Click="BtnZoomOut_Click" Style="{StaticResource NavBtnStyle}" Width="28" Margin="0,0,2,0" ToolTip="화면 축소"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    <Button Content="+" Click="BtnZoomIn_Click" Style="{StaticResource NavBtnStyle}" Width="28" Margin="0,0,8,0" ToolTip="화면 확대"/>

                    <!-- No-Activate Shield Toggle (교탁 마우스 보호 모드) -->
                    <ToggleButton x:Name="ToggleShieldMode" Content="🛡️ 마우스 보호 ON" Checked="ToggleShieldMode_Checked" Unchecked="ToggleShieldMode_Unchecked" IsChecked="True" Height="32" Padding="10,4" Margin="0,0,6,0" Background="#059669" Foreground="White" BorderBrush="#34D399" BorderThickness="1.5" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="[보호 켜짐] 학생이 화면을 터치해도 교탁 PC 마우스 커서와 작업이 안전하게 유지됩니다">
                        <ToggleButton.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </ToggleButton.Resources>
                    </ToggleButton>

                    <!-- Monitor Switch -->
                    <Button x:Name="BtnSwitchMonitor" Content="📺 모니터 2" Click="BtnSwitchMonitor_Click" Style="{StaticResource NavBtnStyle}" Margin="0,0,6,0" ToolTip="창을 모니터 1 ↔ 모니터 2로 즉시 이동"/>

                    <!-- Fullscreen -->
                    <Button Content="🔲" Click="BtnFullscreen_Click" Style="{StaticResource NavBtnStyle}" Width="32" Margin="0,0,6,0" ToolTip="전체 화면 토글"/>

                    <!-- Close -->
                    <Button Content="✕" Click="BtnClose_Click" Background="#EF4444" Foreground="White" BorderThickness="0" Width="32" Height="32" FontSize="13" FontWeight="Bold" Cursor="Hand" ToolTip="창 닫기">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Bookmarks / Quick Links Bar -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⭐ 빠른 링크:" Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="🔴 유튜브" Click="QuickLink_Click" Tag="https://www.youtube.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="🏫 구글 클래스룸" Click="QuickLink_Click" Tag="https://classroom.google.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="⚡ 띵커벨" Click="QuickLink_Click" Tag="https://www.tkbell.co.kr" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="📌 패들렛" Click="QuickLink_Click" Tag="https://padlet.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="🎬 넷플릭스" Click="QuickLink_Click" Tag="https://www.netflix.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="🟢 네이버" Click="QuickLink_Click" Tag="https://www.naver.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="🔵 구글" Click="QuickLink_Click" Tag="https://www.google.com" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="📚 에듀넷·티-클리어" Click="QuickLink_Click" Tag="https://www.edunet.net" Style="{StaticResource QuickLinkBtnStyle}"/>
                    <Button Content="🧩 카훗 (Kahoot)" Click="QuickLink_Click" Tag="https://kahoot.it" Style="{StaticResource QuickLinkBtnStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Web View Surface -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <ProgressBar x:Name="LoadingBar" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" Panel.ZIndex="10" Visibility="Collapsed"/>

            <!-- Fallback Message if WebView2 is missing -->
            <StackPanel x:Name="PanelFallback" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚠️ WebView2 런타임 초기화 대기 중" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="시스템의 Microsoft Edge WebView2 런타임을 준비하고 있습니다..." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Content="기본 시스템 브라우저로 열기" Click="BtnOpenSystemBrowser_Click" Background="#2563EB" Foreground="White" Padding="12,6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <!-- WebView2 Control -->
            <wv2:WebView2 x:Name="BrowserWebView"/>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="#090D16" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="TxtShieldStatus" DockPanel.Dock="Right" Text="🛡️ 교탁 PC 마우스 보호 중 (비간섭 모드)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtStatus" Text="준비 완료" FontSize="11" Foreground="#64748B"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
