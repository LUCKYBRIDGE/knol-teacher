<Window x:Class="KnolTeacher.Desktop.Views.Windows.StudentDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="놀보드" Height="850" Width="1350"
        Icon="/assets/board_icon.ico"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Board Top/Dock Action Button Style (Bright Clean Theme) -->
        <Style x:Key="BoardNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0369A1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Pill Style -->
        <Style x:Key="BoardAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BoardNavButtonStyle}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#0369A1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#075985" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bright Board Radio Style -->
        <Style x:Key="BoardRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,0,5,0">
                                <Ellipse x:Name="Ring" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#0284C7" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#0284C7" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Board Eraser Segment Radio Style (Bright Theme) -->
        <Style x:Key="BoardSegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="6,2"
                                Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Control Toolbar -->
            <RowDefinition Height="56" />
            <!-- Main Board Surface (Canvas & Ink) -->
            <RowDefinition Height="*" />
            <!-- Bottom Dock Toolbar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Control Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Clock -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBoardTitle" Text="🏫 학생 화면" FontWeight="Bold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#F0F9FF" CornerRadius="8" BorderBrush="#BAE6FD" BorderThickness="1" Padding="10,4" Margin="0,0,14,0">
                        <TextBlock x:Name="TxtClock" Text="09:00:00" FontFamily="Consolas, Malgun Gothic" FontSize="13.5" FontWeight="Bold" Foreground="#0284C7"/>
                    </Border>
                </StackPanel>

                <!-- Center: Presets & Widgets & Board Themes & Drawing -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- View Mode Switcher -->
                        <Border Background="#F1F5F9" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbBoardModeDashboard" Content="🏫 학급 대시보드" IsChecked="True" Checked="RbBoardMode_Checked" Style="{StaticResource BoardSegmentRadioStyle}" FontSize="11" FontWeight="Bold" Padding="8,4"/>
                                <RadioButton x:Name="RbBoardModeWidgets" Content="🧩 자유 위젯" Checked="RbBoardMode_Checked" Style="{StaticResource BoardSegmentRadioStyle}" FontSize="11" FontWeight="Bold" Padding="8,4"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,8,12,8" Width="1" Background="#E2E8F0"/>

                        <!-- Add Widget Dropdown -->
                        <TextBlock Text="+ 위젯:" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CbAddWidget"
                                  Width="156"
                                  Height="32"
                                  MinHeight="32"
                                  FontSize="11"
                                  Padding="6,2"
                                  Background="#F8FAFC"
                                  Foreground="#0F172A"
                                  BorderBrush="#CBD5E1"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0"
                                  SelectionChanged="CbAddWidget_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="Padding" Value="7,4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#0C4A6E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="위젯 추가..." IsSelected="True"/>
                            <ComboBoxItem Content="⏱️ 수업 타이머" Tag="timer"/>
                            <ComboBoxItem Content="🌱 뽑기 레이스" Tag="pinball"/>
                            <ComboBoxItem Content="🙋 발표자 추첨" Tag="picker"/>
                            <ComboBoxItem Content="🎲 스마트 주사위" Tag="dice"/>
                            <ComboBoxItem Content="🎡 회전 돌림판" Tag="wheel"/>
                            <ComboBoxItem Content="🏆 모둠 점수판" Tag="score"/>
                            <ComboBoxItem Content="✏️ 판서 메모장" Tag="drawing"/>
                            <ComboBoxItem Content="🟩 칠판" Tag="blackboard"/>
                            <ComboBoxItem Content="📅 오늘의 시간표" Tag="timetable"/>
                            <ComboBoxItem Content="🍱 오늘의 급식" Tag="meal"/>
                            <ComboBoxItem Content="📝 학급 알림장" Tag="memo"/>
                            <ComboBoxItem Content="📋 과제 체크리스트" Tag="checklist"/>
                            <ComboBoxItem Content="📱 실시간 QR코드" Tag="qr"/>
                            <ComboBoxItem Content="☀️ 날씨 &amp; 미세먼지" Tag="weather"/>
                            <ComboBoxItem Content="🎯 D-Day 카운트다운" Tag="dday"/>
                        </ComboBox>

                        <!-- Lock & Opacity Tools -->
                        <ToggleButton x:Name="ToggleLockWidgets" Content="🔓 위치 고정" Checked="ToggleLockWidgets_Checked" Unchecked="ToggleLockWidgets_Unchecked" Height="32" Padding="8,4" Margin="0,0,4,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="보드 위 모든 위젯의 위치와 크기 조절 잠금">
                            <ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ToggleButton.Resources>
                        </ToggleButton>

                        <!-- Card Opacity Popup -->
                        <Button x:Name="BtnOpacityPopup" Content="💧 투명도" Click="BtnOpacityPopup_Click" Height="32" Padding="8,4" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="위젯 카드 배경 투명도 조절">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Popup x:Name="PopupOpacity" PlacementTarget="{Binding ElementName=BtnOpacityPopup}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Width="200">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Opacity="0.15" ShadowDepth="4" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="위젯 카드 배경 투명도" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Slider x:Name="SliderCardOpacity" Minimum="0.2" Maximum="1.0" Value="0.95" ValueChanged="SliderCardOpacity_ValueChanged" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock x:Name="TxtOpacityValue" Text="95%" Foreground="#0284C7" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Separator Margin="0,8,12,8" Width="1" Background="#E2E8F0"/>

                        <!-- Board Themes -->
                        <TextBlock Text="배경:" Foreground="#475569" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="🏫 초록칠판" Click="BtnGreenBoard_Click" Height="30" Padding="8,2" Margin="0,0,4,0" Background="#143628" Foreground="#86EFAC" BorderBrush="#22C55E" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="📋 화이트" Click="BtnWhiteBoard_Click" Height="30" Padding="8,2" Margin="0,0,4,0" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1.5" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Content="🌙 다크" Click="BtnDarkBoard_Click" Height="30" Padding="8,2" Margin="0,0,12,0" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Separator Margin="0,8,12,8" Width="1" Background="#E2E8F0"/>

                        <!-- Drawing Overlay Mode -->
                        <ToggleButton x:Name="ToggleInkMode" Content="✏️ 보드 필기" Checked="ToggleInkMode_Checked" Unchecked="ToggleInkMode_Unchecked" Height="32" Padding="10,4" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="보드판 위에 펜으로 자유롭게 필기합니다 (단축키: ESC로 필기 모드 해제)">
                            <ToggleButton.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ToggleButton.Resources>
                        </ToggleButton>

                        <StackPanel x:Name="PanelInkTools" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                            <RadioButton x:Name="RbPen" Content="✏️ 펜" GroupName="StudentBoardToolGroup" IsChecked="True" Checked="RbPen_Checked" Style="{StaticResource BoardRadioStyle}" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>

                            <!-- 지우개 시스템 세그먼트 (부분, 획, 구역, 영역) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RbEraserPoint" Content="🧹 부분" GroupName="StudentBoardToolGroup" Checked="RbEraserPoint_Checked" Style="{StaticResource BoardSegmentRadioStyle}" ToolTip="마우스/펜으로 문지른 궤적만 부분 삭제"/>
                                    <RadioButton x:Name="RbEraserStroke" Content="⚡ 획" GroupName="StudentBoardToolGroup" Checked="RbEraserStroke_Checked" Style="{StaticResource BoardSegmentRadioStyle}" ToolTip="터치한 글자나 선 단위로 통째로 삭제"/>
                                    <RadioButton x:Name="RbEraserBox" Content="⬚ 구역" GroupName="StudentBoardToolGroup" Checked="RbEraserBox_Checked" Style="{StaticResource BoardSegmentRadioStyle}" ToolTip="직사각형 박스를 드래그하여 구역 내 글씨 일괄 삭제"/>
                                    <RadioButton x:Name="RbEraserLasso" Content="⟲ 영역" GroupName="StudentBoardToolGroup" Checked="RbEraserLasso_Checked" Style="{StaticResource BoardSegmentRadioStyle}" ToolTip="자유롭게 올가미로 둘러친 영역 안의 글씨 일괄 삭제"/>
                                </StackPanel>
                            </Border>
                            <Button Width="20" Height="20" Background="#0F172A" Click="BtnColor_Click" Tag="#0F172A" Margin="0,0,3,0" Cursor="Hand" BorderBrush="#334155" BorderThickness="1" ToolTip="검정">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Width="20" Height="20" Background="#DC2626" Click="BtnColor_Click" Tag="#DC2626" Margin="0,0,3,0" Cursor="Hand" BorderThickness="0" ToolTip="빨강">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Width="20" Height="20" Background="#2563EB" Click="BtnColor_Click" Tag="#2563EB" Margin="0,0,3,0" Cursor="Hand" BorderThickness="0" ToolTip="파랑">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Width="20" Height="20" Background="#EAB308" Click="BtnColor_Click" Tag="#EAB308" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" ToolTip="노랑">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="↩" Click="BtnUndo_Click" Height="26" Padding="6,0" Margin="0,0,3,0" Background="#E2E8F0" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Cursor="Hand" ToolTip="실행 취소"/>
                            <Button Content="🗑" Click="BtnClear_Click" Height="26" Padding="6,0" Margin="0,0,8,0" Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="판서 지우기"/>

                            <Separator Margin="0,4,8,4" Width="1" Background="#CBD5E1"/>

                            <!-- Math 교구 Tools -->
                            <Button Content="📏 자" Click="BtnToggleRuler_Click" Height="26" Padding="6,0" Margin="0,0,3,0" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="0~20cm 직선자"/>
                            <Button Content="📐 삼각자" Click="BtnToggleTriangle_Click" Height="26" Padding="6,0" Margin="0,0,3,0" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="45°-45°-90° 삼각자"/>
                            <Button Content="🧭 각도기" Click="BtnToggleProtractor_Click" Height="26" Padding="6,0" Margin="0,0,4,0" Background="#F1F5F9" Foreground="#D97706" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="180° 반원 각도기"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Window Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenWebBrowser" Content="🌐 내장 웹" Click="BtnOpenWebBrowser_Click" Margin="0,0,6,0" Padding="9,5" Background="#F0F9FF" Foreground="#0284C7" BorderBrush="#38BDF8" BorderThickness="1.5" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="크롬/유튜브/넷플릭스 호환 무간섭 스마트 웹 브라우저 열기">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnOpenPowerPoint" Content="📊 무간섭 PPT" Click="BtnOpenPowerPoint_Click" Margin="0,0,6,0" Padding="9,5" Background="#FFF7ED" Foreground="#EA580C" BorderBrush="#FDBA74" BorderThickness="1.5" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="모니터 1 작업 중에도 소리·영상이 끊기지 않는 파워포인트 슬라이드 쇼 열기">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <!-- PPT 원격 슬라이드 리모컨 (포커스 이동 없는 원클릭 제어) -->
                    <Border x:Name="PptRemoteControlPanel" Visibility="Collapsed" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 PPT:" FontSize="10.5" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="◀ 이전" Click="BtnPptPrevSlide_Click" Height="22" Padding="5,0" Margin="0,0,3,0" Background="#FFFFFF" Foreground="#EA580C" BorderBrush="#FDBA74" BorderThickness="1" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="파워포인트 이전 슬라이드로 이동"/>
                            <Button Content="다음 ▶" Click="BtnPptNextSlide_Click" Height="22" Padding="5,0" Margin="0,0,3,0" Background="#EA580C" Foreground="#FFFFFF" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="파워포인트 다음 슬라이드로 이동"/>
                            <Button Content="✕" Click="BtnPptCloseSlide_Click" Height="22" Padding="4,0" Background="Transparent" Foreground="#9A3412" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="슬라이드 쇼 종료"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnSwitchBoardMonitor" Content="📺 모니터 2 (학생용)" Click="BtnSwitchBoardMonitor_Click" Margin="0,0,6,0" Padding="10,5" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1.5" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="놀보드를 모니터 1 ↔ 모니터 2로 즉시 이동">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button Content="🔲 전체화면" Click="BtnFullscreen_Click" Margin="0,0,6,0" Padding="10,5" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button Content="✕ 닫기 (F2)" Click="BtnClose_Click" Padding="12,5" Background="#DC2626" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Board Surface Area -->
        <Grid Grid.Row="1" x:Name="BoardContainer" Background="#F1F5F9">
            <!-- Smart Classroom Dashboard Panel (학생용 대시보드 모드) -->
            <Grid x:Name="PanelStudentDashboard" Visibility="Visible" Background="#F1F5F9">
                <Grid.RowDefinitions>
                    <!-- Dashboard Top Header Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dashboard 3-Column Content Body -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Classroom Title & Period Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock Text="🏫 우리 반 스마트 교실" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                            </Border>
                            <Border x:Name="BdDashboardPeriod" Background="#0284C7" CornerRadius="8" Padding="10,4">
                                <TextBlock x:Name="TxtDashboardPeriod" Text="🔔 2교시 수업 중 (10:00~10:40)" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- Center: Date & Day -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDashboardDate" Text="2026년 10월 5일 월요일" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <!-- Right: Big Clock & Fullscreen Hint -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F0F9FF" CornerRadius="8" BorderBrush="#BAE6FD" BorderThickness="1" Padding="12,4">
                                <TextBlock x:Name="TxtDashboardClock" Text="09:00:00" FontFamily="Consolas, Malgun Gothic" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3-Column Content Body -->
                <Grid Grid.Row="1" Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <!-- 1. Daily Timetable (오늘의 시간표) -->
                        <ColumnDefinition Width="340"/>
                        <!-- 2. Submission & Classroom Tasks (오늘/이번주 제출&할일 - 핵심!) -->
                        <ColumnDefinition Width="*"/>
                        <!-- 3. Daily Meal & D-Day Notice (오늘의 급식 & 디데이/알림장) -->
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Daily Timetable Column -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="14,12" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="✏️ 편집" Click="BtnDashboardEditTimetable_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="주간 시간표 편집 창 열기"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="오늘의 시간표" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDashboardDayOfWeek" Text="(월)" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Periods List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DashboardListPeriods">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Period Number -->
                                                    <Border Width="28" Height="28" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Period}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Subject & Room -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Subject}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                            <Border Background="#0284C7" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="수업 중" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TimeRange}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <!-- Room/Tag Badge -->
                                                    <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Footer / Current Period Info -->
                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtDashboardPeriodSummary" Text="총 6교시 수업 예정" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2. Submission & Classroom Tasks Column (핵심!) -->
                    <Grid Grid.Column="1" Margin="6,0,10,0">
                        <Grid.RowDefinitions>
                            <!-- Today Tasks (오늘 제출&할일) -->
                            <RowDefinition Height="1.2*"/>
                            <!-- Weekly Tasks (이번주 제출&할일) -->
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- 2-A: 오늘 제출 & 할 일 카드 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="TxtDashboardTodayCount" Text="진행 중 2건" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📌" FontSize="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="오늘 제출 &amp; 할 일" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border Background="#EF4444" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="오늘 마감" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <ItemsControl x:Name="DashboardListTodayTasks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Checkbox -->
                                                            <CheckBox IsChecked="{Binding IsCompleted}" Click="StudentTaskCheckbox_Click" PreviewTouchDown="StudentTaskCheckbox_PreviewTouchDown" Tag="{Binding}" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                                                                <CheckBox.LayoutTransform>
                                                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                                                </CheckBox.LayoutTransform>
                                                            </CheckBox>
                                                            <!-- Tag Badge -->
                                                            <Border Grid.Column="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                                                <TextBlock Text="{Binding Tag}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                            </Border>
                                                            <!-- Content Text -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Due Date Badge -->
                                                            <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DueDateText}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding DueDateText}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DueDateText}" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty State -->
                                        <TextBlock x:Name="TxtDashboardTodayEmpty" Text="📌 오늘 등록된 제출 과제나 할 일이 없습니다.&#x0a;(메인화면의 [오늘 제출·할일]에서 추가하면 실시간으로 여기에 뜹니다)" FontSize="12.5" TextAlignment="Center" LineHeight="18" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 2-B: 이번 주 제출 & 할 일 카드 -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="16,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="TxtDashboardWeeklyCount" Text="진행 중 2건" FontSize="11.5" FontWeight="Bold" Foreground="#D97706"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗓️" FontSize="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="이번 주 제출 &amp; 할 일" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border Background="#D97706" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="주간 안내" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <ItemsControl x:Name="DashboardListWeeklyTasks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Checkbox -->
                                                            <CheckBox IsChecked="{Binding IsCompleted}" Click="StudentTaskCheckbox_Click" PreviewTouchDown="StudentTaskCheckbox_PreviewTouchDown" Tag="{Binding}" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                                                                <CheckBox.LayoutTransform>
                                                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                                                </CheckBox.LayoutTransform>
                                                            </CheckBox>
                                                            <!-- Tag Badge -->
                                                            <Border Grid.Column="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1">
                                                                <TextBlock Text="{Binding Tag}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                                                            </Border>
                                                            <!-- Content Text -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Due Date Badge -->
                                                            <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DueDateText}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding DueDateText}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DueDateText}" FontSize="11" Foreground="#D97706" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty State -->
                                        <TextBlock x:Name="TxtDashboardWeeklyEmpty" Text="🗓️ 이번 주 예정된 제출 과제가 없습니다.&#x0a;(메인화면의 [이번주 제출·할일]에서 추가하면 실시간으로 여기에 뜹니다)" FontSize="12.5" TextAlignment="Center" LineHeight="18" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. Daily Meal & D-Day Notice Column -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <!-- Daily Meal (오늘의 급식) -->
                            <RowDefinition Height="1.2*"/>
                            <!-- Notice & D-Day (학급 공지 & 디데이) -->
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- 3-A: 오늘의 급식 카드 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="TxtDashboardMealCalorie" Text="열량 정보" FontSize="11" Foreground="#B45309" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🍱" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="오늘의 맛있는 급식" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Meal Content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                        <TextBlock x:Name="TxtDashboardMealMenu" Text="급식 식단을 불러오는 중입니다..." FontSize="13.5" LineHeight="22" Foreground="#1E293B" FontWeight="Medium" TextWrapping="Wrap"/>
                                    </Border>
                                </ScrollViewer>

                                <!-- Footer: Navigation Buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="◀ 이전" Click="BtnDashboardPrevMeal_Click" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10.5" FontWeight="SemiBold" Padding="8,3" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="오늘" Click="BtnDashboardTodayMeal_Click" Background="#0284C7" Foreground="White" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="10,3" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="다음 ▶" Click="BtnDashboardNextMeal_Click" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="10.5" FontWeight="SemiBold" Padding="8,3" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3-B: D-Day & 학급 안내 카드 -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="14,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- D-Day Box -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Notice Memo Box -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- D-Day Banner -->
                                <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🎯 학급 목표 D-Day" FontSize="10.5" Foreground="#991B1B" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtDashboardDDayTitle" Text="학기 목표" FontSize="14" FontWeight="Bold" Foreground="#7F1D1D" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#DC2626" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDashboardDDayCount" Text="D-Day" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Notice Memo Summary -->
                                <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="📢" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="학급 알림장 메모" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TxtDashboardNotice" Text="학급 알림장 내용이 여기에 실시간으로 표시됩니다." FontSize="12.5" LineHeight="20" Foreground="#451A03" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Widgets Canvas (Movable & Resizable Widgets Layer) -->
            <Canvas x:Name="WidgetCanvas" ClipToBounds="True" Background="Transparent" Visibility="Collapsed"/>

            <!-- Transparent Ink Canvas Overlay for Drawing Mode -->
            <InkCanvas x:Name="BoardInkCanvas"
                       Background="Transparent"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>

            <!-- Eraser Preview Canvas for Box / Lasso guidelines -->
            <Canvas x:Name="BoardEraserPreviewCanvas"
                    IsHitTestVisible="False"/>

            <!-- Math Tools Canvas (Ruler, Triangle, Protractor) -->
            <Canvas x:Name="BoardToolsCanvas"
                    IsHitTestVisible="True"/>

            <!-- Keep the empty hint readable on green, white and dark board themes. -->
            <Border x:Name="EmptyBoardHint"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.95"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="4" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="놀보드 캔버스" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="하단 도구 바 또는 상단 '+ 위젯' 메뉴에서 원하는 도구를 클릭하여 자유롭게 띄워보세요." FontSize="13" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="(단축키: ESC - 선택된 위젯·필기 닫기 | F2 - 놀보드 닫기)" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Bottom Dock Toolbar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Handle Bar -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="버튼을 눌러 원하는 도구 위젯을 보드 위에 띄우거나 끕니다 (자유 이동 및 크기 조절, 활성 도구 하이라이트)" Foreground="#475569" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleDock" Content="▼ 도구 바 접기" Click="BtnToggleDock_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#475569" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="6,2"/>
                    </Grid>
                </Border>

                <!-- Dock Body -->
                <Border Grid.Row="1" x:Name="DockBody" Padding="12,8" Background="#FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- NolBoard widget and classroom tool buttons -->
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button x:Name="BtnToolTimer" Content="⏱️ 수업 타이머" Click="DockToolBtn_Click" Tag="timer" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolPinball" Content="🌱 뽑기 레이스" Click="DockToolBtn_Click" Tag="pinball" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="별도 레이스 창에서 32종 동물 아바타로 발표자를 뽑습니다"/>
                            <Button x:Name="BtnToolPicker" Content="🙋 발표자 추첨" Click="DockToolBtn_Click" Tag="picker" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolDice" Content="🎲 주사위·통계" Click="DockToolBtn_Click" Tag="dice" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolWheel" Content="🎡 돌림판" Click="DockToolBtn_Click" Tag="wheel" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolScore" Content="🏆 모둠 점수판" Click="DockToolBtn_Click" Tag="score" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolDrawing" Content="✏️ 판서 메모장" Click="DockToolBtn_Click" Tag="drawing" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="자유롭게 이동 및 크기 조절이 가능한 미니 판서장 위젯"/>
                            <Button x:Name="BtnToolBlackboard" Content="🟩 칠판" Click="DockToolBtn_Click" Tag="blackboard" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="보드 위에 별도로 띄워 쓰는 이동·크기조절 가능한 칠판 위젯"/>
                            <Button x:Name="BtnToolTimetable" Content="📅 오늘의 시간표" Click="DockToolBtn_Click" Tag="timetable" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolMeal" Content="🍱 오늘의 급식" Click="DockToolBtn_Click" Tag="meal" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolMemo" Content="📝 학급 알림장" Click="DockToolBtn_Click" Tag="memo" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}"/>
                            <Button x:Name="BtnToolChecklist" Content="📋 과제 체크리스트" Click="DockToolBtn_Click" Tag="checklist" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="학생 제출물·과제 번호별 완료 체크"/>
                            <Button x:Name="BtnToolQr" Content="📱 수업 QR코드" Click="DockToolBtn_Click" Tag="qr" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="수업 링크 및 자료 QR코드 생성"/>
                            <Button x:Name="BtnToolWeather" Content="☀️ 날씨·미세먼지" Click="DockToolBtn_Click" Tag="weather" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="열 때 즉시 확인하고 열린 동안 15분마다 날씨와 미세먼지를 동기화합니다"/>
                            <Button x:Name="BtnToolDDay" Content="🎯 D-Day" Click="DockToolBtn_Click" Tag="dday" Height="34" Padding="10,0" Margin="0,2,6,2" Style="{StaticResource BoardNavButtonStyle}" ToolTip="학급 목표 D-Day 카운트다운"/>
                        </WrapPanel>

                        <!-- Right: Layout & Close Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSaveBoardLayout" Content="💾 현재 배치 저장" Click="BtnSaveBoardLayout_Click" Height="34" Padding="10,0" Margin="4,2,4,2" Background="#F0F9FF" Foreground="#0284C7" BorderBrush="#BAE6FD" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand" ToolTip="현재 열려있는 위젯들과 배치 위치를 저장하여 다음 실행 시 자동 복원">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="BtnTileWidgets" Content="📐 바둑판 자동 정렬" Click="BtnTileWidgets_Click" Height="34" Padding="12,0" Margin="4,2,4,2" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" ToolTip="열려 있는 위젯들을 화면에 바둑판 형태로 균등 자동 정렬">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="BtnCloseAllWidgets" Content="🧹 전체 닫기" Click="BtnCloseAllWidgets_Click" Height="34" Padding="12,0" Margin="4,2,0,2" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" ToolTip="보드 위의 모든 위젯 닫기">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
